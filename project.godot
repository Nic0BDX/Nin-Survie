; Engine configuration file.
config_version=5

[application]
config/name="Nin Survie"
config/description="Un jeu de survie et de construction sur les îles de Keravel."
run/main_scene="res://main.tscn"
config/icon="res://icon.svg"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/use_custom_user_dir=true
config/custom_user_dir_name="Estran_Keravel"
boot_splash/show_image=false
boot_splash/bg_color=Color(0.043,0.094,0.114,1)

[display]
window/size/viewport_width=1440
window/size/viewport_height=810
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/size/mode=3

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
anti_aliasing/quality/msaa_3d=1
environment/defaults/default_clear_color=Color(0.5,0.7,0.73,1)

[audio]
driver/enable_input=false
